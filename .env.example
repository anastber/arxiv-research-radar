# Copy to .env and fill in GEMINI_API_KEY. Never commit the real .env.

# --- LLM for answers: Gemini (free tier available) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ingestion ---
# arXiv API search query (https://info.arxiv.org/help/api/user-manual.html#query_details)
ARXIV_QUERY=all:"retrieval augmented generation"
# How many of the most recent matching papers to keep in the index
ARXIV_MAX_PAPERS=20

# --- Embeddings (local, free; downloaded from Hugging Face on first run) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Answer generation ---
# Default: gemini-3.5-flash-lite. Check which models your key can use
# (Gemini free-tier limits: https://aistudio.google.com/rate-limit).

MAX_ANSWER_TOKENS=400
# Thinking tokens count against the output cap, so extra headroom is added and thinking is minimized.
GEMINI_THINKING_HEADROOM=600
GEMINI_THINKING_LEVEL=low

# --- Abuse / cost controls (all optional, defaults shown) ---
ASK_RATE_LIMIT=5/hour
DAILY_CAP=200
MAX_QUESTION_CHARS=500

# --- Frontend (Streamlit) ---
# Where the Streamlit app finds the FastAPI backend
API_URL=http://localhost:8000
