# Copy to .env for local development. On a hosting platform, set these as
# environment variables / secrets instead. Never commit the real .env.

# --- LLM provider for answers: "gemini" (free tier available) or "anthropic" ---
LLM_PROVIDER=gemini
# Only the key for the provider you chose is needed. Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Ingestion ---
# arXiv API search query (https://info.arxiv.org/help/api/user-manual.html#query_details)
ARXIV_QUERY=all:"retrieval augmented generation"
# How many of the most recent matching papers to keep in the index
ARXIV_MAX_PAPERS=20

# --- Embeddings (local, free; downloaded from Hugging Face on first run) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Answer generation ---
# Defaults: gemini-3.5-flash-lite for Gemini, claude-haiku-4-5-20251001 for Anthropic.
# Check which models your key can use (Gemini free-tier limits: https://aistudio.google.com/rate-limit).
# ANSWER_MODEL=
MAX_ANSWER_TOKENS=400
# Gemini only: thinking tokens count against the output cap, so extra headroom is added and thinking is minimized.
GEMINI_THINKING_HEADROOM=600
GEMINI_THINKING_LEVEL=low

# --- Abuse / cost controls (all optional, defaults shown) ---
ASK_RATE_LIMIT=5/hour
DAILY_CAP=200
MAX_QUESTION_CHARS=500
# Number of reverse proxies in front of the app: 1 on Render / Fly.io / HF Spaces, 0 locally.
# Wrong value = per-IP limits break (too high: spoofable; too low on a platform: everyone shares one bucket).
TRUSTED_PROXY_HOPS=0

# --- Frontend (Streamlit) ---
# Where the Streamlit app finds the FastAPI backend
API_URL=http://localhost:8000
