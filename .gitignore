.env
.venv/
__pycache__/
*.pyc
.DS_Store

# runtime state (query log, daily counter) - never committed
data/usage.db
data/queries.log

# live corpus: fetched and indexed by the running API (api/refresh.py), never committed
data/papers.json
data/index/
data/index.new/

# benchmark index: rebuilt locally from data/eval/corpus.json.gz (which is committed)
data/eval/index/
# answer-eval run output: regenerated by `python -m eval.answers run`
data/eval/answers.jsonl

# tooling caches
.pytest_cache/
.ruff_cache/
